# ==============================================================================
# BiharStack AI - Environment Variables
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (NEVER expose to browser/client, server only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Embedding & Vector Configuration (STEP 5)
# ==============================================================================
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# AI Provider API Keys (Server only - NEVER expose through NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# ==============================================================================
# LLM & RAG Engine Configuration (STEP 6)
# ==============================================================================
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_HISTORY_MESSAGES=10
RAG_MAX_CONTEXT_TOKENS=3000
MAX_MESSAGE_LENGTH=4000
# ==============================================================================
# Embeddable Website Widget Configuration (STEP 7)
# ==============================================================================
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000/widget.js
PUBLIC_API_BASE_URL=http://localhost:3000
WIDGET_RATE_LIMIT_PER_MINUTE=15
WIDGET_RATE_LIMIT_GLOBAL_PER_MINUTE=60

# ==============================================================================
# API & Developer Platform Configuration (STEP 8)
# ==============================================================================
API_KEY_RATE_LIMIT_PER_MINUTE=100
API_LOG_RETENTION_DAYS=30
